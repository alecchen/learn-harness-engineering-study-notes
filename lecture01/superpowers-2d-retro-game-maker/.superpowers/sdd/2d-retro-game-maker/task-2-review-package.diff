diff --git a/index.html b/index.html
index f5376dd..c0ab18c 100644
--- a/index.html
+++ b/index.html
@@ -86,20 +86,75 @@ footer button, .btn {
   padding: 6px 16px;
   font-family: inherit;
   font-size: 13px;
   cursor: pointer;
   border-radius: 3px;
 }
 footer button:hover, .btn:hover {
   background: #333;
   color: #fff;
 }
+.toolbar-group {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 0 6px;
+  border-right: 1px solid #333;
+  flex-shrink: 0;
+}
+.toolbar-group:last-child { border-right: none; }
+.swatch {
+  width: 20px;
+  height: 20px;
+  border: 2px solid transparent;
+  border-radius: 2px;
+  cursor: pointer;
+  padding: 0;
+  flex-shrink: 0;
+}
+.swatch.active { border-color: #fff; }
+.tile-thumb {
+  border: 2px solid transparent;
+  cursor: pointer;
+  image-rendering: pixelated;
+  image-rendering: crisp-edges;
+  flex-shrink: 0;
+}
+.tile-thumb.active { border-color: #fff; }
+.tile-label {
+  font-size: 10px;
+  color: #888;
+  max-width: 40px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.toolbar-input {
+  background: #111;
+  color: #ddd;
+  border: 1px solid #444;
+  padding: 2px 6px;
+  font-family: inherit;
+  font-size: 11px;
+  width: 70px;
+}
+.toolbar-btn {
+  background: #222;
+  color: #ddd;
+  border: 1px solid #444;
+  padding: 2px 8px;
+  font-family: inherit;
+  font-size: 11px;
+  cursor: pointer;
+  border-radius: 2px;
+}
+.toolbar-btn:hover { background: #333; color: #fff; }
